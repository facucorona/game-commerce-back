# Copiar a .env y completar. Nunca commitear el .env real.
PORT=3001
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_NAME=videogames
SECRET_KEY=
KEY_SECRET=
URL_ALLOWED=http://localhost:3000
URL=http://localhost:3001/
API_KEY=
DB_SEED=steam
# MercadoPago (opcional: sin esto /payment responde 503)
# ACCESS_TOKEN=
# Google (opcional: sin esto el login con Google se desactiva)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Sincronizador Steam (ver README)
STEAM_SYNC_ENABLED=false
STEAM_CC=ar
STEAM_LANG=english
STEAM_MIN_INTERVAL_MS=600
STEAM_TIMEOUT_MS=25000
STEAM_MAX_RETRIES=3
STEAM_RATE_LIMIT_PAUSE_MS=45000
STEAM_DISCOVERY=
STEAM_APPIDS=
STEAM_PRECIO_EQUIVALENCIA=
STEAM_OFFERS_EVERY=12h
STEAM_CATALOG_EVERY=1d
STEAM_FULL_EVERY=1w
STEAM_CATALOG_LIMIT=200
STEAM_MAX_SCREENSHOTS=5
STEAM_SYNC_INITIAL_DELAY_MS=15000
